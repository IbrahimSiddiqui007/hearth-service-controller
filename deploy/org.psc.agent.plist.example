<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.psc.agent</string>
  <key>ProgramArguments</key><array>
    <string>/Users/psc/service-controller/.venv/bin/python</string>
    <string>-m</string><string>agent.app</string>
    <string>--config</string><string>/Users/psc/Library/Application Support/PSC/agent.local.yaml</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8788</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/psc/service-controller</string>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
</dict></plist>
